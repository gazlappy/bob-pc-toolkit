{
  "name": "pc-cleanup",
  "version": "1.0.0",
  "description": "A small Windows housekeeping app: manage startup programs and reclaim disk space.",
  "main": "main.js",
  "private": true,
  "author": "gazlappy",
  "scripts": {
    "start": "electron .",
    "icon": "electron tools/make-icon.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gazlappy.pccleanup",
    "productName": "PC Cleanup",
    "copyright": "Copyright © 2026 gazlappy",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "PC Cleanup.exe",
      "unicode": true
    },
    "compression": "maximum"
  }
}
