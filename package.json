{
  "name": "pc-cleanup",
  "version": "1.0.0",
  "description": "BOB (Best Of the Best) — an all-in-one Windows bench technician's toolkit: clean up, diagnose, repair and recover.",
  "main": "main.js",
  "private": true,
  "author": "gazlappy",
  "scripts": {
    "start": "electron .",
    "icon": "electron tools/make-icon.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gazlappy.bob",
    "productName": "BOB",
    "copyright": "Copyright © 2026 gazlappy",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "BOB.exe",
      "unicode": true,
      "splashImage": "build/splash.bmp"
    },
    "compression": "store"
  }
}
